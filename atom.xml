---
layout: nil
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
 
 <title>{{ site.name }}</title>
 <subtitle>{{ site.subtitle }}</subtitle>
 <link href="http://blog.philbrook.me/atom.xml" rel="self"/>
 <link href="http://blog.philbrook.me/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>http://blog.philbrook.me/</id>
 <author>
   <name>Unvarnished Infrastructure</name>
   <email>foo@bar.com</email>
 </author>
 
 {% for post in site.posts limit:25 %}
 <entry>
   <title>{{ post.title | xml_escape }}</title>
   <link href="http://blog.philbrook.me{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>http://blog.philbrook.me{{ post.id }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}
 
</feed>
